{
  "manifest_version": 3,
  "name": "标签组检索插件 - Tab Group Search",
  "version": "1.0.0",
  "description": "Chrome 标签组搜索层 + 持久化层，3秒内找到任意已保存网页",
  "permissions": ["storage", "tabGroups", "tabs", "commands", "scripting", "notifications"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "css": ["src/content/index.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-search": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "打开/关闭搜索面板"
    }
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
